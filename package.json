{
  "name": "scoutbook",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:affected": "turbo run test --filter=...[origin/main]",
    "test:p1": "turbo run test --filter=@scoutbook/api",
    "check:flaky": "node scripts/check-flaky-quarantine.mjs",
    "build:affected": "turbo run build --filter=...[origin/main]",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
